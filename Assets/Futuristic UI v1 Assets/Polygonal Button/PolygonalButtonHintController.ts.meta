    - '// @ui {"widget":"label", "label":"<span style=\"color: #34D399; font-weight: bold;\">Automatic On-Start Sequence</span>"}'
    - '// @input boolean autoTriggerOnStart = "true" {"hint":"If true, automatically plays the startDelay -> triggerIn -> afterInDelay -> triggerOut sequence on Lens start."}'
    - '// @input float startDelay = "1.0" {"hint":"Delay in seconds on Lens start before triggering fade in", "showIf":"autoTriggerOnStart"}'
    - '// @input float afterInDelay = "3.0" {"hint":"Duration in seconds to keep hint visible (opacity = 1) before triggering fade out", "showIf":"autoTriggerOnStart"}'

  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA; font-weight: bold; font-size: 14px;\">PolygonalButtonHintController</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Animates PolygonalButton opacity to display tutorial hints & gesture prompts.</span>"}'

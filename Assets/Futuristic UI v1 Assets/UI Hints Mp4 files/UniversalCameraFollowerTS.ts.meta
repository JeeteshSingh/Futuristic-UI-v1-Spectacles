  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #38BDF8; font-weight: bold; font-size: 13px;\">Universal Camera Follower</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Multipurpose spatial follower combining CameraFollower + Tether + Angle Range.</span>"}'

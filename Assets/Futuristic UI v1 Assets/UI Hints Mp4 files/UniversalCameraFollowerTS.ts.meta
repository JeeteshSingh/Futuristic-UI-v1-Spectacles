    - '// @input float horizontalDistanceThresholdCm = 40 {"hint":"Horizontal distance threshold in cm to trigger catch-up"}'
    - '// @input float verticalDistanceThresholdCm = 30 {"hint":"Vertical distance threshold in cm to trigger catch-up"}'

    - '// @input float offsetDistance = 80 {"hint":"Distance in cm directly in front of target view (default: 80 cm)"}'
    - '// @input vec3 positionOffset = {0,0,0} {"hint":"Local XYZ position shift relative to camera view (in cm)"}'
    - '// @input vec3 rotationOffset = {0,0,0} {"hint":"Rotation offset in Euler degrees (Pitch, Yaw, Roll)"}'
    - '// @ui {"widget":"group_end"}'

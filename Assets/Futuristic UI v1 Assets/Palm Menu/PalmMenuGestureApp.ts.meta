  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA; font-weight: bold; font-size: 14px;\">PalmMenuGestureApp</span><br/><span style=\"color: #94A3B8; font-size: 11px;\">Thumb-to-fingertip proximity gesture menu controller.</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #F59E0B; font-weight: bold;\">Finger Button Objects (4 Items)</span>"}'
    - '// @input Component.ScriptComponent indexButton {"hint":"Drag PolygonalButton script for Index Finger button here"}'
    - '// @input Component.ScriptComponent middleButton {"hint":"Drag PolygonalButton script for Middle Finger button here"}'
    - '// @input Component.ScriptComponent ringButton {"hint":"Drag PolygonalButton script for Ring Finger button here"}'
    - '// @input Component.ScriptComponent pinkyButton {"hint":"Drag PolygonalButton script for Pinky Finger button here"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #38BDF8; font-weight: bold;\">SIK Hand Visuals & Camera</span>"}'
    - '// @input Component.ScriptComponent rightHandVisual {"hint":"Drag Right HandVisual component from SIK HandVisuals in scene hierarchy here"}'
    - '// @input Component.ScriptComponent leftHandVisual {"hint":"Drag Left HandVisual component from SIK HandVisuals in scene hierarchy here"}'
    - '// @input Component.Camera worldCamera {"hint":"Drag Main Camera for billboarding calculation (defaults to scene camera)"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #10B981; font-weight: bold;\">Hand Selection & Facing Trigger</span>"}'
    - '// @input int targetHand = "2" {"widget":"combobox", "values":[{"label":"Right Hand Only", "value":0}, {"label":"Left Hand Only", "value":1}, {"label":"Both Hands (Follow Active)", "value":2}]}'
    - '// @input float palmFacingThreshold = "65.0" {"hint":"Camera facing angle threshold in degrees to show palm menu"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #8B5CF6; font-weight: bold;\">Active Finger Enables</span>"}'
    - '// @input boolean enableIndexFinger = "true"'
    - '// @input boolean enableMiddleFinger = "true"'
    - '// @input boolean enableRingFinger = "true"'
    - '// @input boolean enablePinkyFinger = "true"'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #EC4899; font-weight: bold;\">Button Offsets & Billboarding</span>"}'
    - '// @input vec3 positionOffset = {0,0,0} {"hint":"Position offset relative to each finger joint"}'
    - '// @input vec3 rotationOffset = {0,0,0} {"hint":"Rotation offset in degrees"}'
    - '// @input vec3 cameraFacingAxis = "{0, 0, 1}" {"hint":"Local front-facing vector on your button that should look directly at the camera (e.g. {0,0,1} for flat 2D buttons or {0,1,0})"}'
    - '// @input vec3 buttonUpAxis = "{0, 1, 0}" {"hint":"Local top/up vector on your button that should point along the fingers toward fingertips (e.g. {0,1,0} or {1,0,0})"}'
    - '// @input vec3 buttonScale = "{1, 1, 1}" {"hint":"Scale multiplier applied to finger buttons"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #F59E0B; font-weight: bold;\">Thumb Proximity & Press Thresholds</span>"}'
    - '// @input float hoverDistance = "5.0" {"hint":"Distance in cm from thumb tip to fingertip to enter Hover state"}'
    - '// @input float selectDistance = "2.0" {"hint":"Distance in cm from thumb tip to fingertip to trigger Select press"}'
    - '// @input float pressZOffset = "0.8" {"hint":"Upward displacement on hand normal axis when hovered/pressed"}'
    - '// @input float selectCooldown = "0.4" {"hint":"Cooldown delay in seconds between successive selections"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #3B82F6; font-weight: bold;\">Toggle Group Behavior</span>"}'
    - '// @input boolean enableToggleBehavior = "false" {"hint":"If true, buttons act as an exclusive radio-button group (only 1 button active at a time)"}'
    - '// @input boolean allowAllTogglesOff = "false" {"hint":"Allows deselecting active button on second tap, leaving no buttons toggled", "showIf":"enableToggleBehavior"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #EF4444; font-weight: bold;\">Entry Animations</span>"}'
    - '// @input boolean enableEntryAnimation = "true"'
    - '// @input float entryDuration = "0.35" {"hint":"Scale pop-in animation duration per button in seconds", "showIf":"enableEntryAnimation"}'
    - '// @input float entryStaggerTime = "0.05" {"hint":"Delay offset between successive finger buttons", "showIf":"enableEntryAnimation"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #6B7280; font-weight: bold;\">Debug Panel</span>"}'
    - '// @input Component.Text debugText {"hint":"Optional Text component to view live tracking & finger selection status"}'
